# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# runtime data (t340) — engine state, RELION job workdirs, cs->star outputs;
# also keeps Tailwind v4's content auto-detection from watching these trees
# (the dev-server "compiling" storm during job runs)
data/
db/*.db
!db/.gitkeep
# t349 — QA screenshots + anything fetched home lands here; same watcher
# exemption as data/ (text files with class-like tokens would rebuild CSS)
download/


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
# anchor scratch names to the repo ROOT — a bare "test" ignored ANY directory
# named test/ anywhere, which is exactly how the remote-connections test
# route (src/app/api/remote/connections/[id]/test/) vanished from Task 261's
# commit while its e2e stayed green against the working tree
/test
/prompt

server.log
# Skills directory
/skills/
# runtime data
/db/*.db
/db/*.db-journal
/agent-ctx
# RELION engine outputs + runtime state (large real data files)
/data/
/tool-results/
# t274 — early-era legacy data trees, quarantined (see _legacy-archive/README.md);
# the README itself is tracked — the ownership verdict must travel with the repo
/_legacy-archive/*
!/_legacy-archive/README.md
3001
3001.*
qa44-*.png
.qa-logs/

# local demo micrographs (dev fixtures)
/demo-mics/
.family-report.json

# t341 — E2E review suite: scripts are tracked; binary fixtures + PNG
# evidence stay local (fixtures are re-fetched/re-copied by the suites
# themselves — see e2e-review/README.md)
/e2e-review/fixtures/
/e2e-review/*.png
# real EMPIAR-10017 micrographs for the mock cluster (513 MB — fetch per
# services/mock-cluster/README.md; never ship in git)
/services/mock-cluster/fs/data2/empiar-10017/
# t341 — the t340 diag suite's runtime fixtures (recreated on each run)
/services/mock-cluster/fs/data2/csproj-t340/
/services/mock-cluster/fs/data2/t340-bare/
/services/mock-cluster/fs/data2/t340-particles/
/services/mock-cluster/fs/data2/t363-particles/
