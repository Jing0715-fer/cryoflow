#!/usr/bin/env bash
# mock sacct for the CryoFlow mock cluster (t299; t303 grew the stopwatch)
#
# Real Slurm purges finished jobs from squeue almost immediately — squeue
# only knows PENDING/RUNNING/COMPLETING. The terminal truth lives in the
# accounting ledger, which sacct serves. This mock reads the journal that
# sbatch's launcher (COMPLETED/FAILED) and scancel (CANCELLED) append to
# ~/.slurm/accounting, one pipe-delimited row per verdict:
#
#   t299: <jobid>|<STATE>|<exit>:<signal>|<unix-epoch>
#   t303: <jobid>|<STATE>|<exit>:<signal>|<end-epoch>|<start-epoch>|<MaxRSS>
#
# (4-field rows are pre-t303 ledgers — Elapsed renders empty for them, the
# app's honesty contract: served or absent, never guessed.)
#
# Supports the app's poll grammar (aliveCheckScript):
#   sacct -j <id> -n -P -o State,ExitCode            →  "COMPLETED|0:0"
#   sacct -j <id> -n -P -o State,ExitCode,Elapsed,MaxRSS
#                 →  "COMPLETED|0:0|00:00:05|1.25G"   ("" when unserved)
# plus the loose basics (bare listing, -o with JobID/State/ExitCode/…).
# The LAST row for a job wins (re-submissions after requeue supersede).
set -u
SLURM_DIR="$HOME/.slurm"
[ -f "$SLURM_DIR/accounting" ] || exit 0

want_ids=""
noheader=0
cols="JobID,State,ExitCode"
while [ $# -gt 0 ]; do
  case "$1" in
    -j) shift; want_ids="${1:-}" ;;
    --jobs=*) want_ids="${1#--jobs=}" ;;
    -n|--noheader) noheader=1 ;;
    -P|--parsable) noheader=1 ;;
    -o) shift; cols="${1:-$cols}" ;;
    -S|--starttime) shift ;;   # accepted, ignored (whole journal is in RAM-sized)
    -E|--endtime) shift ;;
    --units=*|--allocations|--abbrev) ;;
    *) ;;
  esac
  shift
done

# t303 — seconds → sacct's Elapsed family: [[DD-]hh:]mm:ss
fmt_elapsed() {
  local s=$1 d h m sec
  d=$((s / 86400)); h=$(( (s % 86400) / 3600 )); m=$(( (s % 3600) / 60 )); sec=$((s % 60))
  if [ "$d" -gt 0 ]; then
    printf '%d-%02d:%02d:%02d' "$d" "$h" "$m" "$sec"
  elif [ "$h" -gt 0 ]; then
    printf '%02d:%02d:%02d' "$h" "$m" "$sec"
  else
    printf '%02d:%02d' "$m" "$sec"
  fi
}

render() {
  # $1 = journal row (id|STATE|exit:signal|end|start|maxrss)
  local row="$1" out="" c v
  local jid state xit end start maxrss
  IFS='|' read -r jid state xit end start maxrss <<< "$row"
  IFS=',' read -ra COLS <<< "$cols"
  for c in "${COLS[@]}"; do
    case "$c" in
      JobID) v="$jid" ;;
      State) v="$state" ;;
      ExitCode) v="$xit" ;;
      Elapsed)
        v=""
        case "$end$start" in
          ''|*[!0-9]*) ;;                       # any missing/non-numeric epoch → silence
          *) if [ "$end" -ge "$start" ]; then v="$(fmt_elapsed $((end - start)))"; fi ;;
        esac
        ;;
      MaxRSS) v="${maxrss:-}" ;;
      *) v="" ;;
    esac
    out="${out:+$out|}$v"
  done
  printf '%s\n' "$out"
}

if [ -n "$want_ids" ]; then
  # single/selected-job query: SILENT (exit 0) for a job the journal never
  # met — the exact contract the app's alive-check fallback relies on
  # (no accounting row == the scheduler has no testimony == VANISHED)
  # t346 — the blind lever (E2E): the ledger "has no row yet" for the named
  # ids (or all), the exact silence a slow/asynchronous accounting system
  # serves. Content: one job id per line, or "all".
  if [ -f "$SLURM_DIR/sacct-blind" ]; then
    for b in $(tr '\n' ' ' < "$SLURM_DIR/sacct-blind" 2>/dev/null); do
      for id in $want_ids; do
        if [ "$b" = "$id" ] || [ "$b" = "all" ]; then exit 0; fi
      done
    done
  fi
  oldIFS="$IFS"
  IFS=','
  for id in $want_ids; do
    IFS="$oldIFS"
    [ -n "$id" ] || continue
    line="$(grep -F "$id|" "$SLURM_DIR/accounting" 2>/dev/null | grep -E "^${id}\|" | tail -1)"
    [ -n "$line" ] && render "$line"
  done
  IFS="$oldIFS"
  exit 0
fi

[ "$noheader" = "1" ] || echo "JobID|State|ExitCode"
while IFS= read -r row; do
  [ -n "$row" ] && render "$row"
done < "$SLURM_DIR/accounting"
exit 0
