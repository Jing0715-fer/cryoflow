#!/usr/bin/env python3
"""Mock relion_postprocess for the CryoFlow mock cluster.

t311 — the demo chain's terminal job finally speaks on the mock. The fake
reads the REAL half-map header (dims/angpix via --angpix), audits that
--mask exists when given (real RELION dies on a missing mask file), and
writes the full RELION 5 postprocess dialect:

  <o>.star   data_general (_rlnFinalResolution, _rlnBfactorUsedForSharpening,
             _rlnPixelSize) + data_fsc (four FSC curves: corrected /
             unmasked maps / masked maps / phase-randomized) + data_guinier
             (_rlnResolutionSquared / _rlnLogAmplitudesOriginal /
             _rlnLogAmplitudesSharpened) — the exact columns the app's FSC
             and Guinier parsers consume.
  <o>.mrc    the sharpened map — REAL renderable MRC (mode 2 float32, the
             half-map's geometry, deterministic interior blob + LCG texture).
  <o>_mask.mrc  an echo of the solvent mask (the identity card's partner).

The FSC curve speaks the refine stub's own crossing law (one voice for the
whole mock world): cosine decay from ~0.95 crossing 0.143 exactly at the
estimate. t457 fixed the physics in three places — the estimate is clamped
to never beat 2x angpix (the old clamp was inverted: min(..., 0.92xNyquist)
FORCED the claim past the box edge and left the corrected curve uncrossed
inside the table), the refinement's own run_model.star estimate leads when
present (the mask buys it <=4%), and the curve order is real (raw masked >
corrected > unmasked — masking flatters, the correction claws back, solvent
noise drags the unmasked halves). The run.out line says "Final resolution"
so the engine's own parseFinalResolution speaks the record's result.
"""
import math
import os
import struct
import sys

argv = sys.argv[1:]
opts = {}
i = 0
while i < len(argv):
    a = argv[i]
    if a.startswith("--"):
        opts[a[2:]] = argv[i + 1] if i + 1 < len(argv) else ""
        i += 2
    else:
        i += 1

src = opts.get("i", "")
if not src or not os.path.exists(src):
    print(
        f"cryoflow-mock postprocess: the half-map is missing ({src or 'no --i given'}) — refusing to invent a map",
        file=sys.stderr,
    )
    sys.exit(1)

mask = opts.get("mask", "")
if mask and not os.path.exists(mask):
    print(
        f"cryoflow-mock postprocess: the solvent mask is missing ({mask}) — real RELION dies here too, refusing",
        file=sys.stderr,
    )
    sys.exit(1)

with open(src, "rb") as fh:
    head = fh.read(1024)
nx, ny, nz = struct.unpack_from("<3i", head, 0)
if nx <= 0 or ny <= 0 or nz <= 0 or nx > 4096 or ny > 4096 or nz > 4096:
    print(
        f"cryoflow-mock postprocess: {src} carries an implausible header ({nx}x{ny}x{nz}) — refusing",
        file=sys.stderr,
    )
    sys.exit(1)

angpix = float(opts.get("angpix", "1.24") or 1.24)
out_base = opts.get("o", "postprocess")
if out_base.endswith("/"):
    out_base += "postprocess"
os.makedirs(os.path.dirname(os.path.abspath(out_base)), exist_ok=True)

# ---- the estimate: the refinement's own word first, the box's law second ---
# t457 — the old clamp was INVERTED: min(..., 0.92 x Nyquist) forced the
# claim FINER than the box edge (6.514 A against a 7.08 A Nyquist), and the
# corrected curve never crossed 0.143 inside the table (the crossing lived
# past the last shell), so the app's official criterion came back empty.
# The physics: a postprocess estimate can never beat 2x angpix. When the
# half-maps' own refinement wrote run_model.star (the run these halves come
# from), its estimate leads — the mask buys it a few percent, the box owns
# the ceiling; without it the box law speaks alone.
nyq = 1.0 / (2.0 * angpix)          # 1/A at the box edge
box_floor = 2.2 * angpix            # headroom for the masked curve's own crossing


def read_refine_estimate(half_map):
    """_rlnCurrentResolution from the refinement's own run_model.star."""
    import re
    star = os.path.join(os.path.dirname(os.path.abspath(half_map)), "run_model.star")
    try:
        with open(star) as fh:
            m = re.search(r"_rlnCurrentResolution\s+([0-9.]+)", fh.read())
        v = float(m.group(1)) if m else 0.0
        return v if v > 0 else None
    except Exception:
        return None


refine_est = read_refine_estimate(src)
if refine_est:
    final_res = max(refine_est * 0.96, box_floor)  # the mask buys <=4%; the box owns the ceiling
else:
    final_res = max(6.0, angpix * 3.2, box_floor)
final_freq = 1.0 / final_res
n_shells = 40
freqs = [nyq * (idx + 1) / n_shells for idx in range(n_shells)]
rand_at = float(opts.get("randomize_at", "0") or 0)  # A; phase-randomize beyond


def corrected_at(f):
    """The corrected curve: the refine stub's own crossing dialect —
    1/(1+(1.3478*R*f)^6) crosses 0.143 exactly at f = 1/R. One voice for
    the whole mock world's FSC, and steep enough that all THREE curves
    cross inside the table (the shallow cosine shape kept the raw masked
    curve above 0.143 past the last shell — its crossing never spoke)."""
    return 1.0 / (1.0 + (1.3478 * final_res * f) ** 6)


star_path = out_base + ".star"
with open(star_path, "w") as fh:
    fh.write("data_general\n\n")
    fh.write(f"_rlnFinalResolution {final_res:.3f}\n")
    fh.write("_rlnBfactorUsedForSharpening -62.4\n")
    fh.write(f"_rlnPixelSize {angpix:.4f}\n")
    fh.write("_rlnUnfilteredMapHalfFraction 0.5\n\n")
    fh.write("data_fsc\n\nloop_\n")
    fh.write("_rlnResolution #1\n")
    fh.write("_rlnAngstromResolution #2\n")
    fh.write("_rlnFourierShellCorrelationCorrected #3\n")
    fh.write("_rlnFourierShellCorrelationUnmaskedMaps #4\n")
    fh.write("_rlnFourierShellCorrelationMaskedMaps #5\n")
    fh.write("_rlnCorrectedFourierShellCorrelationPhaseRandomizedMaskedMaps #6\n")
    for f in freqs:
        corrected = corrected_at(f)
        # t457 — the curve order FIXED: masking BOOSTS the correlation (the
        # raw masked curve rides above the corrected one — the flattery the
        # phase-randomization correction exists to claw back), and the
        # unmasked halves sit BELOW (solvent noise drags them down). The
        # gaps grow with frequency and are proportional to the curve
        # itself, so every curve crosses inside the table.
        rise = min(1.0, f / final_freq)
        masked = min(1.0, corrected * (1.0 + 0.28 * rise))
        unmasked = max(0.0, corrected * (1.0 - 0.22 * rise))
        # phase-randomized: noise floor past the randomization point
        pr = max(0.0, 0.15 * math.exp(-3.0 * f / final_freq)) if (rand_at <= 0 or (1.0 / f) < rand_at) else 0.0
        fh.write(
            f"{f:.6f}\t{1.0 / f:.4f}\t{corrected:.6f}\t{unmasked:.6f}\t{masked:.6f}\t{pr:.6f}\n"
        )
    fh.write("\ndata_guinier\n\nloop_\n")
    fh.write("_rlnResolutionSquared #1\n")
    fh.write("_rlnLogAmplitudesOriginal #2\n")
    fh.write("_rlnLogAmplitudesSharpened #3\n")
    bfac = -62.4
    for idx in range(24):
        f = nyq * (idx + 1) / 24.0
        f2 = f * f
        orig = 6.2 - 9.5 * f2
        sharp = orig + bfac * f2 / 4.0
        fh.write(f"{f2:.6f}\t{orig:.4f}\t{sharp:.4f}\n")


def write_mrc(path, nz_out, seed_base):
    """Minimal valid mode-2 float32 MRC with the half-map's geometry."""
    data = bytearray()
    n = nx * ny * nz_out
    for k in range(n):
        v = ((seed_base * 1103515245 + k * 12345) % 2000) / 2000.0 - 0.25
        data += struct.pack("<f", v)
    header = bytearray(1024)
    struct.pack_into("<3i", header, 0, nx, ny, nz_out)
    struct.pack_into("<i", header, 12, 2)  # MODE (MRC2014 word 3)
    struct.pack_into("<3i", header, 16, 0, 0, 0)  # NXSTART NYSTART NZSTART
    struct.pack_into("<3i", header, 28, nx, ny, nz_out)  # MX MY MZ
    struct.pack_into("<3f", header, 40, float(nx) * angpix, float(ny) * angpix, float(nz_out) * angpix)
    struct.pack_into("<3f", header, 52, 90.0, 90.0, 90.0)  # CELLB
    struct.pack_into("<3i", header, 64, 1, 2, 3)  # MAPC MAPR MAPS
    struct.pack_into("<3f", header, 76, -0.25, 0.75, 0.25)  # DMIN DMAX DMEAN
    struct.pack_into("<i", header, 88, 1)  # ISPG
    struct.pack_into("<i", header, 92, 0)  # NSYMBT
    struct.pack_into("<3f", header, 96, 0.0, 0.0, 0.0)  # ORIGIN
    header[208:212] = b"MAP "
    header[212:216] = b"\x44\x41\x00\x00"
    struct.pack_into("<f", header, 216, 0.16)  # RMS
    struct.pack_into("<i", header, 220, 1)  # NLABL
    with open(path, "wb") as fh:
        fh.write(header)
        fh.write(bytes(data))


map_path = out_base + ".mrc"
# t380 — the sharpened map carries cryo density convention (NEGATIVE protein
# core over zero-mean solvent): the app's ortho viewer flips it to the bright
# blob a real postprocess.mrc shows. The _mask.mrc stays all-positive 0..1
# (a soft mask never flips — the polarity gate's all-positive branch).
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    import cf_cryo
except Exception:
    cf_cryo = None
if cf_cryo is not None:
    cf_cryo.write_mrc(map_path, nx, ny, nz, cf_cryo.negative_volume(nz, int(final_res * 7) % 97 + 3), angpix=angpix)
else:
    write_mrc(map_path, nz, int(final_res * 7) % 97 + 3)
mask_out = out_base + "_mask.mrc"
write_mrc(mask_out, nz, 11)

print(
    f"cryoflow-mock postprocess: {src} + {os.path.basename(mask) if mask else '(no mask)'} @ {angpix:g} A/px"
)
print(f"Auto-sharpening: B-factor {bfac:.1f} A^2 applied")
# t311 — the number must come IMMEDIATELY after "Final resolution": the
# engine's parseFinalResolution regex grabs the first digit run after the
# phrase, and the FSC criterion in parentheses (0.143) used to be read as
# the resolution itself ("FSC(0.143) = 0.143 A" — a lie the app then spoke)
print(f"Final resolution: {final_res:.2f} Angstroms (FSC=0.143)")
print(f"Wrote {map_path}, {star_path}, {mask_out}")
sys.exit(0)
