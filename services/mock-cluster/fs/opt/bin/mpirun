#!/usr/bin/env bash
# mock mpirun for the CryoFlow mock cluster (t297/t345)
#
# An MPI launcher that pretends: -n/-np/--map-by etc. are swallowed, the
# single command is exec'd as rank 0 — with OMPI_COMM_WORLD_RANK=0 and
# PMIX_RANK=0 exported, because t345's per-rank card launcher
# (.cf-rank-launch.sh) reads the rank index and must find one (a real
# MPI runtime always provides it; the mock pretends honestly now).
#
# With the ~/.slurm/mpi-emulate-ranks lever present, the command instead
# runs N times — once per rank index, sequentially — so the E2E suite
# can prove every rank was pinned to its OWN CUDA_VISIBLE_DEVICES
# (the CRYOFLOW_RANK_BIND lines land in run.out). The stub binaries are
# idempotent, so N sequential runs write the same outputs N times
# harmlessly.
n="1"
while [ $# -gt 0 ]; do
  case "$1" in
    -n|-np)
      n="$2"
      shift 2
      ;;
    -npersocket|-max-ppr|--map-by|--mca|-host|-H)
      # flag + value pairs
      shift 2
      ;;
    -np=*|--map-by=*)
      shift
      ;;
    -*)
      # single-dash flags without values (oversubscribe, verbose…)
      shift
      ;;
    *)
      break
      ;;
  esac
done
if [ $# -eq 0 ]; then
  echo "mpirun (mock): no command given" >&2
  exit 1
fi
case "$n" in
  ''|*[!0-9]*) n=1 ;;
esac
if [ -f "$HOME/.slurm/mpi-strip-env" ]; then
  # t346 — the PRRTE non-forwarding world: every rank starts with an EMPTY
  # environment (not even PATH — `env -i`), the way OpenMPI 5's prterun can
  # treat a non-MPI app. The per-rank launcher (.cf-rank-launch.sh) must
  # rebuild its world from the .cf-rank-env dump the sbatch script wrote —
  # a rank that depended on mpirun's env forwarding would die "command not
  # found" here. Rank env still provided (a real runtime always does).
  rc=0
  i=0
  while [ "$i" -lt "$n" ]; do
    env -i OMPI_COMM_WORLD_RANK="$i" PMIX_RANK="$i" "$@"
    this_rc=$?
    [ "$this_rc" -ne 0 ] && rc="$this_rc"
    i=$((i + 1))
  done
  exit "$rc"
fi
if [ -f "$HOME/.slurm/mpi-emulate-ranks" ]; then
  rc=0
  i=0
  while [ "$i" -lt "$n" ]; do
    OMPI_COMM_WORLD_RANK="$i" PMIX_RANK="$i" "$@"
    this_rc=$?
    [ "$this_rc" -ne 0 ] && rc="$this_rc"
    i=$((i + 1))
  done
  exit "$rc"
fi
export OMPI_COMM_WORLD_RANK=0
export PMIX_RANK=0
exec "$@"
