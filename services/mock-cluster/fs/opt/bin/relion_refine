#!/usr/bin/env python3
"""Mock relion_refine for the CryoFlow mock cluster.

Star-aware since t308 (the way t307 taught relion_preprocess): a 2D/3D
classification CONSUMES the input particles star — the fake reads --i,
counts the LAST data block's rows (RELION convention: particles last, so
the data_optics row is never counted), audits that every referenced stack
resolves relative to the STAR'S OWN DIR (a torn array merge or a star
moved away from its tree refuses with a legible count instead of
silently classifying ghosts), and echoes the input rows' ImageName into
run_data.star with a class column appended (provenance: the classes
describe exactly the particles the merged star listed, in the same
order). A missing --i refuses to invent particles.
"""
import os
import struct
import sys
import time

argv = sys.argv[1:]
opts = {}
i = 0
while i < len(argv):
    a = argv[i]
    if a.startswith("--"):
        opts[a[2:]] = argv[i + 1] if i + 1 < len(argv) else ""
        i += 2
    else:
        i += 1

outdir = opts.get("o", "./").rstrip("/").rstrip("/")
if outdir.endswith("/run"):
    outdir = outdir[: -len("/run")]
os.makedirs(outdir, exist_ok=True)
iters = int(opts.get("iter", opts.get("maxiter", "12")))
ncls = int(opts.get("K", "3"))
mode = opts.get("mode", "classify2d")

# ---- the input star is the contract (t308) ------------------------------
star_in = opts.get("i", "")
if not star_in or not os.path.exists(star_in):
    print(
        f"cryoflow-mock refine: the input star is missing ({star_in or 'no --i given'}) — refusing to invent particles",
        file=sys.stderr,
    )
    sys.exit(1)

# parse data_ blocks; the LAST block owns the particles (data_optics comes
# first and its single row must never be counted as a particle)
blocks = []
cur = None
with open(star_in) as fh:
    for line in fh:
        s = line.strip()
        if s.startswith("data_"):
            cur = []
            blocks.append(cur)
        elif cur is not None:
            if s and not s.startswith("loop_") and not s.startswith("_") and not s.startswith("#"):
                cur.append(s)
rows = blocks[-1] if blocks else []
if not rows:
    print(
        f"cryoflow-mock refine: {star_in} carries no particle rows (a torn merge lands headerless) — refusing",
        file=sys.stderr,
    )
    sys.exit(1)
npart = len(rows)

star_dir = os.path.dirname(os.path.abspath(star_in))

# t311 — the echo RELOCATES the rows (they land in THIS job's run_data.star,
# not the upstream's dir), so every ref re-points at the stacks from their
# new home: resolve against the star's dir OR the cwd (the project root —
# the wrapper cds there, the real RELION convention) and re-emit
# project-relative. A verbatim echo left rows like extra/x.mrcs meaning
# "the upstream's extra/" inside a directory that has no extra/ — the same
# relocation disease the engine's own natives caught this window.
def rebase_ref(ref):
    if os.path.isabs(ref):
        return ref
    for base in (star_dir, os.getcwd()):
        p = os.path.join(base, ref)
        if os.path.exists(p):
            return os.path.relpath(p, os.getcwd())
    return ref

# merge-integrity audit: every ImageName after the @ resolves relative to
# the STAR'S OWN DIR (absolute paths pass as-is). One missing stack means
# the canonical star is torn or drifted from its extra/ tree — real RELION
# dies inside HealpixSampling::readStar on exactly this shape.
# t311 — real RELION resolves star rows against the process CWD (the
# PROJECT ROOT — the pipeliner writes project-relative paths). On this mock
# the launcher runs each job from ITS OWN workdir, so a project-relative
# row resolves from the star's PARENT (dirname(star_dir) == the project
# root by layout law). The audit accepts star-dir, cwd, or project root.
star_dir = os.path.dirname(os.path.abspath(star_in))
# t315 — cluster-absolute rows name the MOCK's mounts, which live under the
# mock's fs root on the host (the mock server exports it). Every absolute
# candidate also gets its fs-root translation tried.
MOCK_ROOT = os.environ.get("CRYOFLOW_MOCK_FS_ROOT", "")
missing = 0
for r in rows:
    # real RELION loop rows are WHITESPACE-separated (t311: the engine's own
    # natives emit space-joined rows) — a hard tab split swallowed the whole
    # line into the stack name and refused every row
    img = r.split()[0]
    if "@" not in img:
        continue
    stack = img.split("@", 1)[1]
    if os.path.isabs(stack):
        candidates = [stack]
        if MOCK_ROOT:
            candidates.append(os.path.join(MOCK_ROOT, stack.lstrip("/")))
    else:
        candidates = [
            os.path.join(star_dir, stack),
            os.path.join(os.getcwd(), stack),
            os.path.join(os.path.dirname(star_dir), stack),
        ]
    if not any(os.path.exists(c) for c in candidates):
        missing += 1
if missing:
    print(
        f"cryoflow-mock refine: {missing} of {npart} particle stacks are missing relative to the star's dir — the merge is torn or the tree moved — refusing",
        file=sys.stderr,
    )
    sys.exit(1)

print(f"cryoflow-mock refine: mode={mode} K={ncls} particles={npart} iters={iters} (from {os.path.basename(star_in)})")


def write_mrc(path, nx, ny, nz, seed):
    """Minimal valid MRC (mode 2, float32) — enough for header readers.

    t311: the header offsets now follow the REAL MRC2014 layout — MODE is
    word 3 (byte 12), NXSTART/NYSTART/NZSTART words 4-6 (16), MX/MY/MZ words
    7-9 (28), DMIN/DMAX/DMEAN words 19-21 (76), ISPG word 22 (88), NSYMBT
    word 23 (92), ORIGIN words 24-26 (96), RMS word 54 (216). The old writer
    put MODE at byte 4 — overwriting NY with 2 — and packed the sampling
    into the NXSTART slot; the app's lenient montage path still drew tiles,
    but every honest header reader (readMrcHeader's own dims, Mol*, real
    RELION) read a 64x2x64 sliver. The fake's dialect now reaches the header.
    """
    data = bytearray()
    for k in range(nx * ny * nz):
        v = ((seed * 1103515245 + k * 12345) % 1000) / 1000.0 - 0.5
        data += struct.pack("<f", v)
    header = bytearray(1024)
    struct.pack_into("<3i", header, 0, nx, ny, nz)          # NX,NY,NZ
    struct.pack_into("<i", header, 12, 2)                   # MODE float32 (word 3)
    struct.pack_into("<3i", header, 16, 0, 0, 0)            # NXSTART, NYSTART, NZSTART
    struct.pack_into("<3i", header, 28, nx, ny, nz)         # MX,MY,MZ sampling
    struct.pack_into("<3f", header, 40, float(nx), float(ny), float(nz))  # CELLA
    struct.pack_into("<3f", header, 52, 90.0, 90.0, 90.0)   # CELLB angles
    struct.pack_into("<3i", header, 64, 1, 2, 3)            # MAPC, MAPR, MAPS
    struct.pack_into("<3f", header, 76, -0.5, 0.5, 0.0)     # DMIN, DMAX, DMEAN
    struct.pack_into("<i", header, 88, 1)                   # ISPG
    struct.pack_into("<i", header, 92, 0)                   # NSYMBT (no extended header)
    struct.pack_into("<3f", header, 96, 0.0, 0.0, 0.0)      # ORIGIN
    header[208:212] = b"MAP "                               # MAP magic
    header[212:216] = b"\x44\x41\x00\x00"                   # MACHST little-endian
    struct.pack_into("<f", header, 216, 0.29)               # RMS
    struct.pack_into("<i", header, 220, 1)                  # NLABL
    with open(path, "wb") as fh:
        fh.write(header)
        fh.write(bytes(data))


for it in range(1, iters + 1):
    time.sleep(0.9)
    tag = f"it [{it:03d}]"
    print(f" {tag}  :   R1=0.4{it % 9} R2=0.3{it % 8} fsc=0.{8 - (it % 4)} ll={-120 + it * 3}.{it % 10} avgmax=0.0{it % 30}")
    sys.stdout.flush()
    its = f"{it:03d}"
    data_star = os.path.join(outdir, f"run_it{its}_data.star")
    with open(data_star, "w") as fh:
        fh.write("\ndata_particles\n\nloop_\n")
        fh.write("_rlnImageName #1\n")
        fh.write("_rlnClassNumber #2\n")
        fh.write("_rlnAngleRot #3\n")
        fh.write("_rlnAngleTilt #4\n")
        fh.write("_rlnAnglePsi #5\n")
        # provenance: echo the INPUT rows' ImageName (first tab field) —
        # the classes describe exactly the particles the star listed, with
        # every ref RE-BASED to this star's own home (t311)
        for p, r in enumerate(rows):
            img = r.split()[0]
            if "@" in img:
                n, stack = img.split("@", 1)
                img = f"{n}@{rebase_ref(stack)}"
            cls = (p * 7 + it) % ncls + 1
            fh.write(f"{img}\t{cls}\t{p * 13.0:.1f}\t{90.0 - p}.2\t{p * 3.0:.1f}\n")
    for c in range(1, ncls + 1):
        write_mrc(os.path.join(outdir, f"run_it{its}_class{c:03d}.mrc"), 64, 64, 1, c * 31 + it)
    # t350 — per-iteration 2D class-average STACK (run_it###_classes.mrcs):
    # what a REAL relion_refine class2d writes every iteration and what the
    # live class gallery renders slice-by-slice. One file, nz = ncls, each
    # slice its own deterministic gray field (class c ≈ c*31+it, so two
    # classes never render identical). Additive only — the final-artifact
    # rename below and every collector's expectations are untouched.
    write_mrc(os.path.join(outdir, f"run_it{its}_classes.mrcs"), 64, 64, ncls, 4096 + it)
    # E2E extension (2026-09 review): REAL relion_refine in 3D mode also
    # writes per-iteration half-maps + an optimiser.star. The app's
    # REFINE_FAMILY_CANDIDATES (engine.ts) expect run_it###_half1_class###.mrc
    # / run_it###_optimiser.star for class3d & refine3d — without them the
    # half1/half2/map/optimiser ports never resolve and the chain (mask
    # create, postprocess, multibody) stalls at "waiting". Volumes are 3D
    # (64³) like a real map; class2d jobs are unaffected (their candidates
    # only look at run_data.star / run_classes.mrcs).
    write_mrc(os.path.join(outdir, f"run_it{its}_half1_class001.mrc"), 64, 64, 64, 101 + it)
    write_mrc(os.path.join(outdir, f"run_it{its}_half2_class001.mrc"), 64, 64, 64, 202 + it)
    with open(os.path.join(outdir, f"run_it{its}_optimiser.star"), "w") as fh:
        fh.write(f"\ndata_optimiser\n\n_rlnCurrentIteration {it}\n_rlnNumberOfClasses {ncls}\n")

# final artifacts collectOutputs looks for
# t354 — COPY, not rename: real relion_refine leaves EVERY per-iteration
# file on disk (run_it004_data.star etc.) and writes the final aliases
# ALONGSIDE them; the old os.replace here ate the last round's data.star,
# so a finished class2d's iteration list came up one round short (the
# chips bar could never offer the final round). Additive change: the
# aliases are byte-identical, the per-iteration originals now survive.
def copy_final(src, dst):
    with open(src, "rb") as a, open(dst, "wb") as b:
        b.write(a.read())


final_classes = os.path.join(outdir, "run_classes.mrcs")
copy_final(os.path.join(outdir, f"run_it{iters:03d}_class001.mrc"), final_classes)
final_data = os.path.join(outdir, "run_data.star")
copy_final(os.path.join(outdir, f"run_it{iters:03d}_data.star"), final_data)
with open(os.path.join(outdir, "run_model.star"), "w") as fh:
    fh.write("\ndata_\n\n_rlnReferenceImage run_classes.mrcs\n_rlnEstimatedResolution 4.2\n")
# E2E extension (cont.): the final UNFILTERED half-maps + the final class
# volume — real relion_refine's closing move (run_half1_class001_unfil.mrc,
# run_half2_class001_unfil.mrc, run_class001.mrc) and the exact names
# REMOTE_OUTPUT_CANDIDATES resolves half1_mrc/half2_mrc/model_mrc by.
write_mrc(os.path.join(outdir, "run_half1_class001_unfil.mrc"), 64, 64, 64, 9901)
write_mrc(os.path.join(outdir, "run_half2_class001_unfil.mrc"), 64, 64, 64, 9902)
write_mrc(os.path.join(outdir, "run_class001.mrc"), 64, 64, 64, 9903)
copy_final(os.path.join(outdir, f"run_it{iters:03d}_optimiser.star"), os.path.join(outdir, "run_optimiser.star"))
print(f"wrote {final_classes} + {final_data} after {iters} iterations ({npart} particles classified)")
sys.exit(0)
