#!/usr/bin/env python3
"""Mock relion_python_topaz (the conda-env wrapper the autopick Topaz mode
wraps via --fn_topaz_exe). Exists so the t264 probe inventory finds topaz on
the cluster.

t415 adds the DENOISE face: `topaz denoise --i <micrographs.star> -o <dir>/`
(the engine's argv shape). The wrapper is the star→paths bridge on the
compute side — topaz's raw CLI takes image files, the wrapper expands the
star where the files live (local lane: local paths; cluster lane: the staged
star arrives cluster-absolute, so the expansion names cluster files). Per
row it copies the source micrograph to <stem>_denoised.mrc (byte-faithful
mrc header, real file), prints a per-image progress line in the shape real
topaz denoise speaks, and writes a denoised_micrographs.star index that
keeps the micrograph schema — the engine's collectOutputs and the remote
output candidates both key on it."""
import os
import re
import shutil
import sys

MRC_RE = re.compile(r"\.(mrc|mrcs|tif|tiff)$", re.I)


def star_micrographs(star_path):
    """_rlnMicrographName rows from a RELION star. Each name is RESOLVED the
    way the mock relion_autopick resolves its rows (star dir → cwd → star's
    parent): a staged star keeps RELATIVE row names (`micrographs/mic.mrc`)
    while the files themselves land at the project's mapped path — the
    star's parent dir is the level where the two meet. Names that survive
    resolution unchanged stay relative (the caller checks existence)."""
    names = []
    in_loop = False
    col = None
    with open(star_path, "r", errors="replace") as fh:
        for raw in fh:
            line = raw.strip()
            if not line:
                continue
            if line.startswith("loop_"):
                in_loop = True
                col = None
                continue
            if line.startswith("_rln"):
                if in_loop and col is None and line.split()[0] == "_rlnMicrographName":
                    col = True
                continue
            if line.startswith("data_") or line.startswith("#"):
                continue
            if in_loop and col:
                names.append(line.split()[0])

    star_dir = os.path.dirname(os.path.abspath(star_path))
    parent = os.path.dirname(star_dir)

    def resolve(n):
        if os.path.isabs(n):
            return n
        for base in (star_dir, os.getcwd(), parent):
            cand = os.path.normpath(os.path.join(base, n))
            if os.path.exists(cand):
                return cand
        return n  # unresolved — the caller's missing-file exit speaks

    return [resolve(n) for n in names]


def denoise(argv):
    """denoise face: --i <star> -o <outdir>/ [--downscale N] [--num-workers N]"""
    star = None
    outdir = "."
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--i" and i + 1 < len(argv):
            star = argv[i + 1]
            i += 2
            continue
        if a == "-o" and i + 1 < len(argv):
            outdir = argv[i + 1]
            i += 2
            continue
        i += 1
    if not star or not os.path.isfile(star):
        print(f"cryoflow-mock topaz denoise: input star not found: {star}")
        sys.exit(1)
    os.makedirs(outdir, exist_ok=True)
    mics = star_micrographs(star)
    if not mics:
        print("cryoflow-mock topaz denoise: no _rlnMicrographName rows in the star")
        sys.exit(1)
    total = len(mics)
    denoised = []
    for k, mic in enumerate(mics, 1):
        stem = os.path.basename(mic)
        stem = MRC_RE.sub("", stem)
        dest = os.path.join(outdir, stem + "_denoised.mrc")
        if os.path.isfile(mic):
            shutil.copyfile(mic, dest)
        else:
            # a missing row dies per-file like the real CLI would — but the
            # mock keeps the run honest and loud rather than silent
            print(f"cryoflow-mock topaz denoise: missing micrograph {mic}")
            sys.exit(1)
        denoised.append(dest)
        print(f"denoising micrograph {k}/{total}: {os.path.basename(mic)}", flush=True)
    index = os.path.join(outdir, "denoised_micrographs.star")
    with open(index, "w") as fh:
        fh.write("data_optics\n\nloop_\n_rlnOpticsGroupName\n_rlnMicrographOriginalName\n_rlnVoltage\n_rlnSphericalAberration\n_rlnAmplitudeContrast\n_rlnOpticsGroup\nopticsGroup1    300    2.7    0.1    1\n\n")
        fh.write("data_micrographs\n\nloop_\n_rlnMicrographName #1\n")
        for d in denoised:
            fh.write(f"{os.path.abspath(d)}\n")
    print(f"Denoised {total} micrographs — index: {os.path.basename(index)}")
    print("cryoflow-mock topaz denoise: CNN denoising simulated (source bytes copied)")
    sys.exit(0)


def main():
    args = sys.argv[1:]
    if args and args[0] == "denoise":
        denoise(args[1:])
    print("cryoflow-mock topaz: CNN picking would happen here", " ".join(args))
    sys.exit(0)


if __name__ == "__main__":
    main()
