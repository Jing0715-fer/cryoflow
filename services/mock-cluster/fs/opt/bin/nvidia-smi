#!/usr/bin/env bash
# mock nvidia-smi for the CryoFlow mock cluster (t342)
#
# The app's sbatch script asks the NODE two questions at launch: how many
# GPUs does it expose (nvidia-smi -L | wc -l — the rank-clamp truth) and
# how much memory is free on the devices this job would use
# (--id=<ids> --query-gpu=memory.free — the starved-card refusal). This
# stub answers both from levers under ~/.slurm so the E2E suite can dial
# a 1-GPU node, a starved card and stale holder PIDs without owning a
# real GPU:
#   gpu-count     — how many GPUs the node exposes        (default 8)
#   gpu-free-mb   — every device's free memory, MB        (default 20000)
#   gpu-holders   --query-compute-apps rows               (default none)
# The defaults keep every other suite green: 8 cards never clamps a ≤8
# wide dispatch, 20000 MB never trips the 1000 MB refusal.
set -u
D="$HOME/.slurm"
count="$(cat "$D/gpu-count" 2>/dev/null || echo 8)"
free_mb="$(cat "$D/gpu-free-mb" 2>/dev/null || echo 20000)"

mode=""
ids=""
for a in "$@"; do
  case "$a" in
    -L) mode="list" ;;
    --id=*) ids="${a#--id=}" ;;
    --query-compute-apps*) mode="apps" ;;
    --query-gpu=memory.free*) mode="free" ;;
  esac
done

case "$mode" in
  list)
    i=0
    while [ "$i" -lt "$count" ]; do
      echo "GPU $i: mock RTX (UUID: GPU-0000-0000-0000-0000-0000-0000000$i)"
      i=$((i + 1))
    done
    ;;
  free)
    # one line per queried device (or per node GPU when no --id rode)
    if [ -n "$ids" ]; then
      n=$(echo "$ids" | tr ',' '\n' | grep -c . || true)
    else
      n="$count"
    fi
    i=0
    while [ "$i" -lt "$n" ]; do
      echo "$free_mb"
      i=$((i + 1))
    done
    ;;
  apps)
    cat "$D/gpu-holders" 2>/dev/null || true
    ;;
  *)
    exit 0
    ;;
esac
