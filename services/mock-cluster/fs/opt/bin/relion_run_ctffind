#!/usr/bin/env python3
"""Mock relion_run_ctffind for the CryoFlow mock cluster.

Reads --i <micrographs.star>, simulates per-micrograph CTF estimation
(log lines feed the progress parser), writes <outdir>/micrographs_ctf.star
with the same micrographs plus plausible CTF values.
"""
import os
import sys
import time

argv = sys.argv[1:]
opts = {}
i = 0
while i < len(argv):
    a = argv[i]
    if a.startswith("--"):
        opts[a[2:]] = argv[i + 1] if i + 1 < len(argv) else ""
        i += 2
    else:
        i += 1

star_in = opts.get("i")
outdir = opts.get("o", "./").rstrip("/")
if not star_in or not os.path.exists(star_in):
    print(f"ERROR: cannot read input star: {star_in}", file=sys.stderr)
    sys.exit(1)

mics = []
with open(star_in) as fh:
    in_loop = False
    name_col = None
    for line in fh:
        t = line.strip()
        if t == "loop_":
            in_loop = True
            name_col = None
            continue
        if t.startswith("_rlnMicrographName"):
            name_col = t.split()[0]
            continue
        if t.startswith("_") or t.startswith("#") or t.startswith("data_"):
            continue
        if in_loop and t and name_col:
            cols = t.split()
            if cols:
                mics.append(cols[0])

print(f"cryoflow-mock ctffind: {len(mics)} micrograph(s) from {star_in}")
# t311 — TOTAL sleep capped at 60s (motioncorr's own t268 doctrine): the
# 1.6s/mic cadence was tuned for small suites; a 450-micrograph import tree
# turned the run into a 12-minute wall. Small jobs (≤37 mics) keep the full
# cadence the progress parser was tuned against.
pace = min(1.6, 60.0 / max(1, len(mics)))
for n, mic in enumerate(mics, 1):
    time.sleep(pace)
    print(f"Micrograph {n}/{len(mics)}: {os.path.basename(mic)} — CTF estimated (dF=12500, astig=180)")
    sys.stdout.flush()

os.makedirs(outdir, exist_ok=True)
out = os.path.join(outdir, "micrographs_ctf.star")
with open(out, "w") as fh:
    fh.write("\ndata_\n\nloop_\n")
    fh.write("_rlnMicrographName #1\n")
    fh.write("_rlnDefocusU #2\n")
    fh.write("_rlnDefocusV #3\n")
    fh.write("_rlnDefocusAngle #4\n")
    fh.write("_rlnPhaseShift #5\n")
    fh.write("_rlnCtfFigureOfMerit #6\n")
    fh.write("_rlnCtfMaxResolution #7\n")
    for k, mic in enumerate(mics):
        u = 11800 + 700 * ((k % 5) - 2)
        v = u + 160
        fom = 0.07 + 0.004 * (k % 4)
        res = 4.1 + 0.15 * (k % 3)
        fh.write(f"{mic}\t{u}.0\t{v}.0\t{15.0 + k}.0\t0.0\t{fom:.3f}\t{res:.2f}\n")
print(f"wrote {out}")
sys.exit(0)
