# CryoFlow — copy to .env and adjust if needed.
# SQLite database file. Prisma resolves `file:` URLs relative to prisma/,
# so this points at <repo>/db/cryoflow.db.
DATABASE_URL="file:../db/cryoflow.db"

# Optional: decouple the data directory (projects, run records, RELION
# workdirs) from the server cwd. Defaults to <repo>/data when unset.
# CRYOFLOW_DATA_DIR=/absolute/path/to/data
