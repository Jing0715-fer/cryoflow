generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]
  edges     Edge[]
}

model Job {
  id        String    @id @default(cuid())
  projectId String
  type      String
  name      String
  x         Float
  y         Float
  status    String    @default("idle") // idle | queued | running | completed | failed
  progress  Float     @default(0)
  params    String    @default("{}") // JSON-encoded parameter map
  result    String? // JSON-encoded result summary
  startedAt DateTime? // used to derive progress while running
  duration  Int       @default(8000) // simulated run duration in ms
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outEdges Edge[] @relation("fromJob")
  inEdges  Edge[] @relation("toJob")

  @@index([projectId])
}

model Edge {
  id        String   @id @default(cuid())
  projectId String
  fromJobId String
  toJobId   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromJob Job     @relation("fromJob", fields: [fromJobId], references: [id], onDelete: Cascade)
  toJob   Job     @relation("toJob", fields: [toJobId], references: [id], onDelete: Cascade)

  @@unique([fromJobId, toJobId])
  @@index([projectId])
}
