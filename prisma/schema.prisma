generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id         String     @id @default(cuid())
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  jobs       Job[]
  edges      Edge[]
  workspaces Workspace[]
}

/**
 * A sub-canvas inside a project: one project may hold several workspaces
 * (e.g. "Import & CTF" / "Classification" / "Refinement"), each with its own
 * set of nodes. Jobs can be MOVED between workspaces or COPIED as a soft
 * link (Job.linkedJobId) so downstream jobs in another workspace can consume
 * the original's outputs.
 */
model Workspace {
  id        String   @id @default(cuid())
  projectId String
  name      String
  /** Sort position inside the sidebar (ascending). */
  order     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobs    Job[]

  @@index([projectId])
}

model Job {
  id         String    @id @default(cuid())
  projectId  String
  /** Owning workspace (null only for pre-migration rows — always set via the API). */
  workspaceId String?
  /** Soft link target: this job MIRRORS the original and its outputs feed
   *  downstream jobs from this workspace. Deleting the original cascades. */
  linkedJobId String?
  type       String
  name       String
  x          Float
  y          Float
  status     String    @default("idle") // idle | pending | running | completed | failed
  progress   Float     @default(0)
  params     String    @default("{}") // JSON-encoded parameter map
  result     String? // JSON-encoded result summary
  /**
   * Free-text user annotation (the scientist's margin note: "this is the
   * good 3D class — feed it to refine3d"). Cosmetic per-ROW metadata like
   * the name — linked copies carry their own (a link placed into the
   * Classification workspace may deserve its own remark). Empty string is
   * normalized to NULL by the PATCH route; null renders no badge anywhere.
   */
  note       String?
  startedAt  DateTime? // used to derive progress while running
  duration   Int       @default(8000) // simulated run duration in ms
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  linkedJob Job?       @relation("JobLinks", fields: [linkedJobId], references: [id], onDelete: Cascade)
  links     Job[]      @relation("JobLinks")
  outEdges  Edge[]     @relation("fromJob")
  inEdges   Edge[]     @relation("toJob")
  overlaySession OverlaySession?
  bookmarkSession BookmarkSession?

  @@index([projectId])
  @@index([workspaceId])
}

/**
 * Server-side copy of a job's 3D-viewer overlay session (the Layers panel
 * setup: which comparison maps, their colors, opacities and σ nudges).
 * localStorage mirrors it per browser; this row makes the session follow
 * the JOB across browsers and devices. `data` is a JSON-encoded array of
 * { path, name, color, alpha, sigmaOffset } — paths are validated against
 * the job's live outputs on restore, so stale rows self-heal.
 */
model OverlaySession {
  id        String   @id @default(cuid())
  jobId     String   @unique
  data      String
  updatedAt DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

/**
 * Server-side copy of a job's 3D-viewer camera bookmarks (named view
 * poses: orbit/zoom/target, plus a small JPEG thumbnail per bookmark).
 * localStorage mirrors it per browser; this row makes the saved views
 * follow the JOB across browsers and devices. `data` is a JSON-encoded
 * array of { id, name, ts, thumb?, snapshot } — snapshots are pure
 * camera numbers (no file references), so rows never go stale.
 */
model BookmarkSession {
  id        String   @id @default(cuid())
  jobId     String   @unique
  data      String
  updatedAt DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Edge {
  id        String   @id @default(cuid())
  projectId String
  fromJobId String
  toJobId   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromJob Job     @relation("fromJob", fields: [fromJobId], references: [id], onDelete: Cascade)
  toJob   Job     @relation("toJob", fields: [toJobId], references: [id], onDelete: Cascade)

  @@unique([fromJobId, toJobId])
  @@index([projectId])
}
